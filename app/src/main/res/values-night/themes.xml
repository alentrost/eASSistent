<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base dark application theme conforming to Material 3 Expressive standards. -->
    <style name="Base.Theme.EASSistent" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Material 3 Expressive Primary Tones (Dark) -->
        <item name="colorPrimary">@color/ea_blue</item>
        <item name="colorOnPrimary">@color/ea_bg</item>
        <item name="colorPrimaryContainer">@color/ea_blue_light</item>
        <item name="colorOnPrimaryContainer">@color/ea_blue_dark</item>

        <!-- Material 3 Secondary & Tertiary (Dark) -->
        <item name="colorSecondary">@color/ea_text_secondary</item>
        <item name="colorOnSecondary">@color/ea_bg</item>
        <item name="colorSecondaryContainer">@color/ea_surface_variant</item>
        <item name="colorOnSecondaryContainer">@color/ea_text_primary</item>
        <item name="colorTertiary">@color/ea_hour_next_border</item>
        <item name="colorTertiaryContainer">@color/ea_hour_next_bg</item>
        <item name="colorOnTertiaryContainer">@color/ea_hour_next_text</item>

        <!-- Material 3 Surface and Containers (Dark) -->
        <item name="android:colorBackground">@color/ea_bg</item>
        <item name="colorSurface">@color/ea_surface</item>
        <item name="colorOnSurface">@color/ea_text_primary</item>
        <item name="colorSurfaceVariant">@color/ea_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/ea_text_secondary</item>
        <item name="colorOutline">@color/ea_card_border</item>
        <item name="colorOutlineVariant">@color/ea_border</item>

        <!-- M3 Expressive Corner Shapes -->
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.M3.Expressive.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.M3.Expressive.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.M3.Expressive.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.M3.Expressive.ExtraLarge</item>
    </style>
</resources>