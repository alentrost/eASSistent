<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llTabRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    android:background="@drawable/bg_day_tab_unselected"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:minWidth="68dp"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tvTabDay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PON"
        android:textColor="@color/ea_text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvTabDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="28. 9."
        android:textColor="@color/ea_text_secondary"
        android:textSize="11sp" />

</LinearLayout>
