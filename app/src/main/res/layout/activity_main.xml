<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ea_bg"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header Card (Material 3 Expressive Card) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="4dp"
            app:cardBackgroundColor="@color/ea_surface"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp"
            app:strokeColor="@color/ea_card_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/header_padding_horizontal"
                android:paddingTop="@dimen/header_padding_vertical"
                android:paddingEnd="@dimen/header_padding_horizontal"
                android:paddingBottom="@dimen/header_padding_vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvClassName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Urnik"
                            android:textColor="@color/ea_text_primary"
                            android:textSize="@dimen/header_class_name_size"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSchoolTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="eAsistent"
                            android:textColor="@color/ea_text_secondary"
                            android:textSize="@dimen/header_school_title_size" />

                    </LinearLayout>

                    <!-- Navigation & Action Buttons -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Day Navigation chevrons -->
                        <ImageButton
                            android:id="@+id/btnPrevDay"
                            android:layout_width="@dimen/nav_button_size"
                            android:layout_height="@dimen/nav_button_size"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Prejšnji dan"
                            android:padding="@dimen/nav_button_padding"
                            android:src="@drawable/ic_chevron_left" />

                        <ImageButton
                            android:id="@+id/btnNextDay"
                            android:layout_width="@dimen/nav_button_size"
                            android:layout_height="@dimen/nav_button_size"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Naslednji dan"
                            android:padding="@dimen/nav_button_padding"
                            android:src="@drawable/ic_chevron_right" />

                        <!-- 3-Dot Overflow Menu (Toggle View + Settings) -->
                        <ImageButton
                            android:id="@+id/btnMenu"
                            android:layout_width="@dimen/nav_button_size"
                            android:layout_height="@dimen/nav_button_size"
                            android:layout_marginStart="2dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Možnosti"
                            android:padding="@dimen/nav_button_padding"
                            android:src="@drawable/ic_more_vert" />

                    </LinearLayout>

                </LinearLayout>

            <!-- Week badge and last updated -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/llWeekSelector"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="1dp">

                    <ImageButton
                        android:id="@+id/btnPrevWeek"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Prejšnji teden"
                        android:padding="3dp"
                        android:src="@drawable/ic_chevron_left"
                        app:tint="@color/ea_blue_dark" />

                    <TextView
                        android:id="@+id/tvWeekName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="Teden"
                        android:textColor="@color/ea_blue_dark"
                        android:textSize="@dimen/header_week_badge_size"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnNextWeek"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Naslednji teden"
                        android:padding="3dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/ea_blue_dark" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:contentDescription="Zadnja posodobitev"
                        android:src="@drawable/ic_refresh"
                        app:tint="@color/ea_text_muted" />

                    <TextView
                        android:id="@+id/tvLastUpdated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="--:--"
                        android:textColor="@color/ea_text_muted"
                        android:textSize="@dimen/header_last_updated_size" />

                </LinearLayout>

                <!-- Jump to Today button -->
                <TextView
                    android:id="@+id/btnJumpToday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:text="Danes"
                    android:textColor="@color/ea_blue"
                    android:textSize="@dimen/header_jump_today_size"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Empty State View -->
    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:padding="24dp"
        android:text="Ni podatkov o urniku.\nKliknite gumb za osvežitev ali preverite nastavitve."
        android:textColor="@color/ea_text_secondary"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- 1. THREE-DAY FOCUS VIEW WRAPPER (Smooth horizontally scrolling full week strip showing 3 days at a time) -->
    <FrameLayout
        android:id="@+id/flThreeDayWrapper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="true"
        android:clipToPadding="false"
        android:visibility="visible">

        <!-- Smooth horizontally scrolling full week strip -->
        <HorizontalScrollView
            android:id="@+id/hsvThreeDayView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/llThreeDayContentRoot"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- 7-Column Headers: Spacer 0 | Mon 1 | Tue 2 | Wed 3 | Thu 4 | Fri 5 | Spacer 6 -->
                <LinearLayout
                    android:id="@+id/llThreeDayHeadersStrip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:orientation="horizontal">

                    <!-- Col 0: Spacer Header -->
                    <LinearLayout
                        android:id="@+id/llHeader0"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3.5dp"
                        android:layout_marginEnd="3.5dp"
                        android:background="@drawable/bg_header_dimmed"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp">

                        <TextView
                            android:id="@+id/tvHeaderBadge0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⭐ DANES"
                            android:textColor="@color/ea_blue"
                            android:textSize="@dimen/day_badge_size"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvHeaderName0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="@color/ea_text_primary"
                            android:textSize="@dimen/day_name_size"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHeaderDate0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ni podatka"
                            android:textColor="@color/ea_text_secondary"
                            android:textSize="@dimen/day_date_size" />

                    </LinearLayout>

                    <!-- Col 1: Monday Header -->
                    <LinearLayout
                        android:id="@+id/llHeader1"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3.5dp"
                        android:layout_marginEnd="3.5dp"
                        android:background="@drawable/bg_header_dimmed"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp">

                        <TextView
                            android:id="@+id/tvHeaderBadge1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⭐ DANES"
                            android:textColor="@color/ea_blue"
                            android:textSize="@dimen/day_badge_size"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvHeaderName1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ponedeljek"
                            android:textColor="@color/ea_text_primary"
                            android:textSize="@dimen/day_name_size"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHeaderDate1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5. 10."
                            android:textColor="@color/ea_text_secondary"
                            android:textSize="@dimen/day_date_size" />

                    </LinearLayout>

                    <!-- Col 2: Tuesday Header -->
                    <LinearLayout
                        android:id="@+id/llHeader2"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3.5dp"
                        android:layout_marginEnd="3.5dp"
                        android:background="@drawable/bg_header_dimmed"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp">

                        <TextView
                            android:id="@+id/tvHeaderBadge2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⭐ DANES"
                            android:textColor="@color/ea_blue"
                            android:textSize="@dimen/day_badge_size"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvHeaderName2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Torek"
                            android:textColor="@color/ea_text_primary"
                            android:textSize="@dimen/day_name_size"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHeaderDate2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="6. 10."
                            android:textColor="@color/ea_text_secondary"
                            android:textSize="@dimen/day_date_size" />

                    </LinearLayout>

                    <!-- Col 3: Wednesday Header -->
                    <LinearLayout
                        android:id="@+id/llHeader3"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3.5dp"
                        android:layout_marginEnd="3.5dp"
                        android:background="@drawable/bg_header_dimmed"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp">

                        <TextView
                            android:id="@+id/tvHeaderBadge3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⭐ DANES"
                            android:textColor="@color/ea_blue"
                            android:textSize="@dimen/day_badge_size"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvHeaderName3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sreda"
                            android:textColor="@color/ea_text_primary"
                            android:textSize="@dimen/day_name_size"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHeaderDate3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="7. 10."
                            android:textColor="@color/ea_text_secondary"
                            android:textSize="@dimen/day_date_size" />

                    </LinearLayout>

                    <!-- Col 4: Thursday Header -->
                    <LinearLayout
                        android:id="@+id/llHeader4"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3.5dp"
                        android:layout_marginEnd="3.5dp"
                        android:background="@drawable/bg_header_dimmed"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp">

                        <TextView
                            android:id="@+id/tvHeaderBadge4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⭐ DANES"
                            android:textColor="@color/ea_blue"
                            android:textSize="@dimen/day_badge_size"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvHeaderName4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Četrtek"
                            android:textColor="@color/ea_text_primary"
                            android:textSize="@dimen/day_name_size"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHeaderDate4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="8. 10."
                            android:textColor="@color/ea_text_secondary"
                            android:textSize="@dimen/day_date_size" />

                    </LinearLayout>

                    <!-- Col 5: Friday Header -->
                    <LinearLayout
                        android:id="@+id/llHeader5"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3.5dp"
                        android:layout_marginEnd="3.5dp"
                        android:background="@drawable/bg_header_dimmed"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp">

                        <TextView
                            android:id="@+id/tvHeaderBadge5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⭐ DANES"
                            android:textColor="@color/ea_blue"
                            android:textSize="@dimen/day_badge_size"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvHeaderName5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Petek"
                            android:textColor="@color/ea_text_primary"
                            android:textSize="@dimen/day_name_size"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHeaderDate5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="9. 10."
                            android:textColor="@color/ea_text_secondary"
                            android:textSize="@dimen/day_date_size" />

                    </LinearLayout>

                    <!-- Col 6: Spacer Header -->
                    <LinearLayout
                        android:id="@+id/llHeader6"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3.5dp"
                        android:layout_marginEnd="3.5dp"
                        android:background="@drawable/bg_header_dimmed"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp">

                        <TextView
                            android:id="@+id/tvHeaderBadge6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⭐ DANES"
                            android:textColor="@color/ea_blue"
                            android:textSize="@dimen/day_badge_size"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvHeaderName6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="@color/ea_text_primary"
                            android:textSize="@dimen/day_name_size"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHeaderDate6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ni podatka"
                            android:textColor="@color/ea_text_secondary"
                            android:textSize="@dimen/day_date_size" />

                    </LinearLayout>

                </LinearLayout>

                <!-- 7-Column Cards Strip -->
                <LinearLayout
                    android:id="@+id/llThreeDayCardsStrip"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginBottom="4dp"
                    android:orientation="horizontal">

                    <!-- Card 0: Spacer -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardCol0"
                        android:layout_width="120dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="3.5dp"
                        android:layout_marginEnd="3.5dp"
                        app:cardBackgroundColor="@color/ea_dimmed_bg"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="0dp"
                        app:cardPreventCornerOverlap="false"
                        app:strokeColor="@color/ea_card_border"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:id="@+id/llCol0"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical" />

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Card 1: Monday -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardCol1"
                        android:layout_width="120dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="3.5dp"
                        android:layout_marginEnd="3.5dp"
                        app:cardBackgroundColor="@color/ea_surface"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="0dp"
                        app:cardPreventCornerOverlap="false"
                        app:strokeColor="@color/ea_card_border"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:id="@+id/llCol1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical" />

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Card 2: Tuesday -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardCol2"
                        android:layout_width="120dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="3.5dp"
                        android:layout_marginEnd="3.5dp"
                        app:cardBackgroundColor="@color/ea_surface"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="0dp"
                        app:cardPreventCornerOverlap="false"
                        app:strokeColor="@color/ea_card_border"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:id="@+id/llCol2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical" />

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Card 3: Wednesday -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardCol3"
                        android:layout_width="120dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="3.5dp"
                        android:layout_marginEnd="3.5dp"
                        app:cardBackgroundColor="@color/ea_surface"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="0dp"
                        app:cardPreventCornerOverlap="false"
                        app:strokeColor="@color/ea_card_border"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:id="@+id/llCol3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical" />

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Card 4: Thursday -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardCol4"
                        android:layout_width="120dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="3.5dp"
                        android:layout_marginEnd="3.5dp"
                        app:cardBackgroundColor="@color/ea_surface"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="0dp"
                        app:cardPreventCornerOverlap="false"
                        app:strokeColor="@color/ea_card_border"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:id="@+id/llCol4"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical" />

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Card 5: Friday -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardCol5"
                        android:layout_width="120dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="3.5dp"
                        android:layout_marginEnd="3.5dp"
                        app:cardBackgroundColor="@color/ea_surface"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="0dp"
                        app:cardPreventCornerOverlap="false"
                        app:strokeColor="@color/ea_card_border"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:id="@+id/llCol5"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical" />

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Card 6: Spacer -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardCol6"
                        android:layout_width="120dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="3.5dp"
                        android:layout_marginEnd="3.5dp"
                        app:cardBackgroundColor="@color/ea_dimmed_bg"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="0dp"
                        app:cardPreventCornerOverlap="false"
                        app:strokeColor="@color/ea_card_border"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:id="@+id/llCol6"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical" />

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </LinearLayout>

        </HorizontalScrollView>

        <!-- Gradient Overlays: fading to the left and right edges of the screen -->
        <LinearLayout
            android:id="@+id/llGradientOverlays"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:clickable="false"
            android:focusable="false"
            android:orientation="horizontal"
            android:weightSum="3">

            <!-- Left Column edge gradient -->
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_gradient_edge_left"
                android:clickable="false"
                android:focusable="false" />

            <!-- Center Column: transparent (no gradient) -->
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:clickable="false"
                android:focusable="false" />

            <!-- Right Column edge gradient -->
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_gradient_edge_right"
                android:clickable="false"
                android:focusable="false" />

        </LinearLayout>

    </FrameLayout>

    <!-- 2. FULL WEEK TABLE VIEW (Accessible via Toggle Button) -->
    <LinearLayout
        android:id="@+id/layoutTableView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <HorizontalScrollView
            android:id="@+id/hsvWeekTable"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="horizontal">

            <ScrollView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <TableLayout
                    android:id="@+id/tlWeekTable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/ea_bg"
                    android:padding="8dp" />

            </ScrollView>

        </HorizontalScrollView>

    </LinearLayout>

    </LinearLayout>

    <!-- Floating Refresh Action Button (M3 expressive, semi-transparent, default bottom-right, toggleable to bottom-left) -->
    <FrameLayout
        android:id="@+id/fabRefreshContainer"
        android:layout_width="@dimen/fab_size"
        android:layout_height="@dimen/fab_size"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/fab_margin"
        android:alpha="0.72">

        <ImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_fab_refresh"
            android:contentDescription="Osveži urnik"
            android:padding="@dimen/fab_padding"
            android:src="@drawable/ic_refresh"
            app:tint="@color/ea_text_primary" />

        <ProgressBar
            android:id="@+id/pbLoading"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="@color/ea_blue"
            android:visibility="gone" />

    </FrameLayout>

</FrameLayout>