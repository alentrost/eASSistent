<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Row 1: Class Name (Subject) + Classroom Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Class Name / Subject code (e.g. PAPv, MAT, SLO) -->
        <TextView
            android:id="@+id/tvSubitemSubject"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="MAT"
            android:textColor="@color/ea_text_primary"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <!-- Classroom (e.g. E19, E32) -->
        <TextView
            android:id="@+id/tvSubitemRoom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_badge"
            android:paddingStart="4dp"
            android:paddingTop="1dp"
            android:paddingEnd="4dp"
            android:paddingBottom="1dp"
            android:text="E19"
            android:textColor="@color/ea_blue_dark"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Row 2: Professor (e.g. B. Vouk, M. Petrovič) -->
    <TextView
        android:id="@+id/tvSubitemTeacher"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0.5dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="B. Vouk"
        android:textColor="@color/ea_text_secondary"
        android:textSize="10sp"
        android:visibility="gone" />

</LinearLayout>
