<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="14dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="2dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Izbira tedna"
                android:textColor="@color/ea_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- What week we currently are in by date -->
            <TextView
                android:id="@+id/tvCurrentWeekByDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Danes po datumu: Teden 5"
                android:textColor="@color/ea_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCloseWeekPicker"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Zapri"
            android:padding="5dp"
            android:src="@drawable/ic_close"
            app:tint="@color/ea_text_secondary" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="6dp"
        android:background="@color/ea_border" />

    <!-- List of weeks -->
    <ListView
        android:id="@+id/lvWeeks"
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:fadingEdge="vertical"
        android:fadingEdgeLength="12dp"
        android:overScrollMode="never"
        android:requiresFadingEdge="vertical"
        android:scrollbars="vertical" />

</LinearLayout>
