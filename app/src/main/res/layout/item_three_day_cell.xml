<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llCellRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="@dimen/cell_padding_horizontal"
    android:paddingTop="@dimen/cell_padding_vertical"
    android:paddingEnd="@dimen/cell_padding_horizontal"
    android:paddingBottom="@dimen/cell_padding_vertical">

    <!-- Container for class items inside this cell -->
    <LinearLayout
        android:id="@+id/llCellItems"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical" />

    <!-- Container for empty / free state -->
    <LinearLayout
        android:id="@+id/llCellEmpty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvCellEmptyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="@color/ea_text_muted"
            android:textSize="@dimen/cell_empty_text_size" />

    </LinearLayout>

    <!-- Container for Malica -->
    <LinearLayout
        android:id="@+id/llCellMalica"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvMalicaTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🍽️ Malica"
            android:textColor="@color/ea_malica_text"
            android:textSize="@dimen/cell_malica_text_size"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
