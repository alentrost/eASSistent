<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ea_bg"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header Card (Material 3 Expressive Card) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="4dp"
            app:cardBackgroundColor="@color/ea_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/ea_card_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvClassName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Urnik"
                            android:textColor="@color/ea_text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSchoolTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="eAsistent"
                            android:textColor="@color/ea_text_secondary"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <!-- Navigation & Action Buttons -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Day Navigation chevrons -->
                        <ImageButton
                            android:id="@+id/btnPrevDay"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Prejšnji dan"
                            android:padding="5dp"
                            android:src="@drawable/ic_chevron_left" />

                        <ImageButton
                            android:id="@+id/btnNextDay"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Naslednji dan"
                            android:padding="5dp"
                            android:src="@drawable/ic_chevron_right" />

                        <!-- 3-Dot Overflow Menu (Toggle View + Settings) -->
                        <ImageButton
                            android:id="@+id/btnMenu"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="2dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Možnosti"
                            android:padding="5dp"
                            android:src="@drawable/ic_more_vert" />

                    </LinearLayout>

                </LinearLayout>

            <!-- Week badge and last updated -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvWeekName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge"
                    android:paddingStart="7dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="2dp"
                    android:text="Teden"
                    android:textColor="@color/ea_blue_dark"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:contentDescription="Zadnja posodobitev"
                        android:src="@drawable/ic_refresh"
                        app:tint="@color/ea_text_muted" />

                    <TextView
                        android:id="@+id/tvLastUpdated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="--:--"
                        android:textColor="@color/ea_text_muted"
                        android:textSize="10sp" />

                </LinearLayout>

                <!-- Jump to Today button -->
                <TextView
                    android:id="@+id/btnJumpToday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:text="Danes"
                    android:textColor="@color/ea_blue"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Empty State View -->
    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:padding="24dp"
        android:text="Ni podatkov o urniku.\nKliknite gumb za osvežitev ali preverite nastavitve."
        android:textColor="@color/ea_text_secondary"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- 1. THREE-DAY FOCUS VIEW (Main View) -->
    <LinearLayout
        android:id="@+id/layoutThreeDayView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- 3-Column Headers: Yesterday | Today | Tomorrow -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="4dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="3">

            <!-- Column 1 Header: Yesterday -->
            <LinearLayout
                android:id="@+id/llHeaderYesterday"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_header_dimmed"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/tvHeaderYesterdayBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VČERAJ"
                    android:textColor="@color/ea_dimmed_text"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHeaderYesterdayName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sreda"
                    android:textColor="@color/ea_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHeaderYesterdayDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30. 9."
                    android:textColor="@color/ea_text_secondary"
                    android:textSize="10sp" />

            </LinearLayout>

            <!-- Column 2 Header: Today (Highlighted!) -->
            <LinearLayout
                android:id="@+id/llHeaderToday"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:layout_weight="1"
                android:background="@drawable/bg_header_today"
                android:elevation="1dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/tvHeaderTodayBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐ DANES"
                    android:textColor="@color/ea_blue"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHeaderTodayName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Četrtek"
                    android:textColor="@color/ea_blue_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHeaderTodayDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. 10."
                    android:textColor="@color/ea_text_secondary"
                    android:textSize="10.5sp" />

            </LinearLayout>

            <!-- Column 3 Header: Tomorrow -->
            <LinearLayout
                android:id="@+id/llHeaderTomorrow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_header_dimmed"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/tvHeaderTomorrowBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JUTRI"
                    android:textColor="@color/ea_dimmed_text"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHeaderTomorrowName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Petek"
                    android:textColor="@color/ea_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHeaderTomorrowDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. 10."
                    android:textColor="@color/ea_text_secondary"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- FrameLayout for content with Gradient Overlays -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="1">

            <!-- 3 Columns (Rounded by Column!) -->
            <LinearLayout
                android:id="@+id/llThreeDayColumnsContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:weightSum="3">

                <!-- Column 1: Yesterday Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardYesterdayColumn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="2dp"
                    app:cardBackgroundColor="@color/ea_dimmed_bg"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardPreventCornerOverlap="false"
                    app:strokeColor="@color/ea_card_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:id="@+id/llYesterdayColumn"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical" />

                </com.google.android.material.card.MaterialCardView>

                <!-- Column 2: Today Card (Highlighted!) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTodayColumn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="1dp"
                    android:layout_marginEnd="1dp"
                    app:cardBackgroundColor="@color/ea_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardPreventCornerOverlap="false"
                    app:strokeColor="@color/ea_today_border"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:id="@+id/llTodayColumn"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical" />

                </com.google.android.material.card.MaterialCardView>

                <!-- Column 3: Tomorrow Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTomorrowColumn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    app:cardBackgroundColor="@color/ea_dimmed_bg"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardPreventCornerOverlap="false"
                    app:strokeColor="@color/ea_card_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:id="@+id/llTomorrowColumn"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Gradient Overlays: fading to the left and right edges of the screen -->
            <LinearLayout
                android:id="@+id/llGradientOverlays"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:baselineAligned="false"
                android:clickable="false"
                android:focusable="false"
                android:orientation="horizontal"
                android:weightSum="3">

                <!-- Left Column edge gradient -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_gradient_edge_left"
                    android:clickable="false"
                    android:focusable="false" />

                <!-- Center Column: transparent (no gradient) -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:clickable="false"
                    android:focusable="false" />

                <!-- Right Column edge gradient -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_gradient_edge_right"
                    android:clickable="false"
                    android:focusable="false" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

    <!-- 2. FULL WEEK TABLE VIEW (Accessible via Toggle Button) -->
    <LinearLayout
        android:id="@+id/layoutTableView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <HorizontalScrollView
            android:id="@+id/hsvWeekTable"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="horizontal">

            <ScrollView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <TableLayout
                    android:id="@+id/tlWeekTable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/ea_bg"
                    android:padding="8dp" />

            </ScrollView>

        </HorizontalScrollView>

    </LinearLayout>

    </LinearLayout>

    <!-- Floating Refresh Action Button (M3 expressive, semi-transparent, default bottom-right, toggleable to bottom-left) -->
    <FrameLayout
        android:id="@+id/fabRefreshContainer"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:alpha="0.72">

        <ImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_fab_refresh"
            android:contentDescription="Osveži urnik"
            android:padding="13dp"
            android:src="@drawable/ic_refresh"
            app:tint="@color/ea_text_primary" />

        <ProgressBar
            android:id="@+id/pbLoading"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="@color/ea_blue"
            android:visibility="gone" />

    </FrameLayout>

</FrameLayout>